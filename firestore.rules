rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1주차 연결 테스트 전용
    match /connectionTests/{id} {
      allow create: if true;
    }
    // 코칭 신청: 쓰기(생성)만 허용, 읽기/수정/삭제는 모두 막음 (신청 내용은 콘솔에서만 확인)
    match /applications/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nick','tier','agent','discord','problem','want','createdAt'])
        && request.resource.data.keys().hasAll(['nick','tier','agent','discord','problem','want','createdAt'])
        && request.resource.data.nick is string && request.resource.data.nick.size() > 0 && request.resource.data.nick.size() <= 1000
        && request.resource.data.tier is string && request.resource.data.tier.size() > 0 && request.resource.data.tier.size() <= 20
        && request.resource.data.agent is string && request.resource.data.agent.size() > 0 && request.resource.data.agent.size() <= 1000
        && request.resource.data.discord is string && request.resource.data.discord.size() >= 2 && request.resource.data.discord.size() <= 32
        && request.resource.data.problem is string && request.resource.data.problem.size() > 0 && request.resource.data.problem.size() <= 1000
        && request.resource.data.want is string && request.resource.data.want.size() > 0 && request.resource.data.want.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    // 코칭 후기: 새 후기는 approved=false 로만 생성 가능, 읽기는 승인된(approved=true) 문서만 가능.
    // 승인은 Firebase 콘솔에서 approved 값을 true 로 바꿔서 한다 (수정/삭제는 앱에서 불가).
    match /reviews/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nick','rating','text','tierBefore','tierAfter','approved','createdAt'])
        && request.resource.data.keys().hasAll(['nick','rating','text','tierBefore','tierAfter','approved','createdAt'])
        && request.resource.data.approved == false
        && request.resource.data.nick is string && request.resource.data.nick.size() > 0 && request.resource.data.nick.size() <= 20
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.tierBefore in ['아이언 1','아이언 2','아이언 3','브론즈 1','브론즈 2','브론즈 3','실버 1','실버 2','실버 3','골드 1','골드 2','골드 3','플래티넘 1','플래티넘 2','플래티넘 3','다이아몬드 1','다이아몬드 2','다이아몬드 3','초월자 1','초월자 2','초월자 3','불멸 1','불멸 2','불멸 3','레디언트']
        && request.resource.data.tierAfter in ['아이언 1','아이언 2','아이언 3','브론즈 1','브론즈 2','브론즈 3','실버 1','실버 2','실버 3','골드 1','골드 2','골드 3','플래티넘 1','플래티넘 2','플래티넘 3','다이아몬드 1','다이아몬드 2','다이아몬드 3','초월자 1','초월자 2','초월자 3','불멸 1','불멸 2','불멸 3','레디언트']
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read: if resource.data.approved == true;
      allow update, delete: if false;
    }
  }
}
