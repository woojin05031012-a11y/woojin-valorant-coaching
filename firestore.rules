rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자: 지정한 Google 계정으로 로그인한 경우만 (이메일 인증 완료 필수)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'woojin05031012@gmail.com';
    }

    // 신청서 입력값 검사 (신청 생성/수정에 공통 사용)
    function appOk(d) {
      return d.nick is string && d.nick.size() > 0 && d.nick.size() <= 1000
        && d.tier is string && d.tier.size() > 0 && d.tier.size() <= 20
        && d.agent is string && d.agent.size() > 0 && d.agent.size() <= 1000
        && d.discord is string && d.discord.size() >= 2 && d.discord.size() <= 32
        && d.problem is string && d.problem.size() > 0 && d.problem.size() <= 1000
        && d.want is string && d.want.size() > 0 && d.want.size() <= 1000;
    }

    // 1주차 연결 테스트 전용
    match /connectionTests/{id} {
      allow create: if true;
    }

    // 코칭 신청
    // - 생성: 누구나 (상태는 항상 '접수'로 시작)
    // - 개별 조회(get): 문서 ID(신청 번호)를 아는 사람만. 목록 조회(list)는 관리자만
    // - 수정: 상태가 '접수'일 때만 신청자가 내용을 고치거나 '취소'로 바꿀 수 있음
    // - 관리자: 모든 조회/수정/삭제
    match /applications/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nick','tier','agent','discord','problem','want','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['nick','tier','agent','discord','problem','want','status','createdAt','updatedAt'])
        && appOk(request.resource.data)
        && request.resource.data.status == '접수'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow get: if true;
      allow list: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.status == '접수'
            && request.resource.data.updatedAt == request.time
            && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nick','tier','agent','discord','problem','want','updatedAt'])
                && appOk(request.resource.data))
              ||
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
                && request.resource.data.status == '취소')
            ));
      allow delete: if isAdmin();
    }

    // 코칭 후기
    // - 생성: 누구나, 항상 approved=false 로만
    // - 읽기: 승인된(approved=true) 후기만. 관리자는 전체
    // - 승인/수정/삭제: 관리자만
    match /reviews/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nick','rating','text','tierBefore','tierAfter','approved','createdAt'])
        && request.resource.data.keys().hasAll(['nick','rating','text','tierBefore','tierAfter','approved','createdAt'])
        && request.resource.data.approved == false
        && request.resource.data.nick is string && request.resource.data.nick.size() > 0 && request.resource.data.nick.size() <= 20
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.tierBefore in ['아이언 1','아이언 2','아이언 3','브론즈 1','브론즈 2','브론즈 3','실버 1','실버 2','실버 3','골드 1','골드 2','골드 3','플래티넘 1','플래티넘 2','플래티넘 3','다이아몬드 1','다이아몬드 2','다이아몬드 3','초월자 1','초월자 2','초월자 3','불멸 1','불멸 2','불멸 3','레디언트']
        && request.resource.data.tierAfter in ['아이언 1','아이언 2','아이언 3','브론즈 1','브론즈 2','브론즈 3','실버 1','실버 2','실버 3','골드 1','골드 2','골드 3','플래티넘 1','플래티넘 2','플래티넘 3','다이아몬드 1','다이아몬드 2','다이아몬드 3','초월자 1','초월자 2','초월자 3','불멸 1','불멸 2','불멸 3','레디언트']
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read: if resource.data.approved == true || isAdmin();
      allow update, delete: if isAdmin();
    }

    // FAQ (질문과 답변)
    // - 읽기: 게시된(published=true) 것만. 관리자는 전체
    // - 방문자 질문 접수: published=false, 답변 비어 있음, 통계 0 으로만 생성
    // - 통계: 게시된 FAQ의 views(조회수) 또는 votes(도움이 됐어요)를 1씩만 올릴 수 있음
    // - 작성/게시/삭제: 관리자만
    match /faqs/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['q','a','views','votes','published','source','createdAt'])
            && request.resource.data.keys().hasAll(['q','a','views','votes','published','source','createdAt'])
            && request.resource.data.q is string && request.resource.data.q.size() >= 5 && request.resource.data.q.size() <= 200
            && request.resource.data.a == ''
            && request.resource.data.views == 0
            && request.resource.data.votes == 0
            && request.resource.data.published == false
            && request.resource.data.source == 'user'
            && request.resource.data.createdAt == request.time);
      allow update: if isAdmin()
        || (resource.data.published == true
            && (
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                && request.resource.data.views == resource.data.views + 1)
              ||
              (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
                && request.resource.data.votes == resource.data.votes + 1)
            ));
      allow delete: if isAdmin();
    }
  }
}
